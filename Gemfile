source "https://rubygems.org"

gem "jekyll", "~> 4.3"

# Reference/default theme. Swap by changing `theme:`/`remote_theme:` in
# _config.yml — see THEME-CONTRACT.md. Any theme following the contract
# can replace this gem without touching content or CMS config.
gem "minima", "~> 2.5"

# Windows/JRuby: tzinfo-data isn't bundled by default.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw]

group :jekyll_plugins do
  gem "jekyll-polyglot"
end
